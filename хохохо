// Игровой процесс
void playGame() {
    initBoard();
    int currentPlayer = 1;
    int winner = 0;
    int move, row, col;
    
    while (winner == 0) {
        // Очистка экрана (условная)
        for (int i = 0; i < 50; i++) cout << "\n";
        
        cout << "=== КРЕСТИКИ-НОЛИКИ ===\n";
        drawBoard();
        
        if (currentPlayer == 1) {
            cout << player1Nick << " (" << player1Symbol << "), введите номер клетки (1-9): ";
            cin >> move;
            
            if (cin.fail() || move < 1 || move > 9) {
                cin.clear();
                cin.ignore(1000, '\n');
                cout << "Ошибка! Нажмите Enter...";
                cin.get();
                cin.get();
                continue;
            }
            
            row = (move - 1) / 3;
            col = (move - 1) % 3;
            
            if (board[row][col] == player1Symbol || board[row][col] == player2Symbol) {
                cout << "Клетка занята! Нажмите Enter...";
                cin.get();
                cin.get();
                continue;
            }
            
            board[row][col] = player1Symbol;
            
            if (checkWin(player1Symbol)) {
                winner = 1;
                break;
            }
            if (checkDraw()) {
                winner = 3;
                break;
            }
            currentPlayer = 2;
        } 
        else { // currentPlayer == 2
            if (gameMode == 1) {
                // Режим с компьютером
                cout << "Ход компьютера (" << player2Symbol << ")...\n";
                computerMove();
                
                if (checkWin(player2Symbol)) {
                    winner = 2;
                    break;
                }
                if (checkDraw()) {
                    winner = 3;
                    break;
                }
                currentPlayer = 1;
            } 
            else {
                // Режим для двоих
                cout << player2Nick << " (" << player2Symbol << "), введите номер клетки (1-9): ";
                cin >> move;
                
                if (cin.fail() || move < 1 || move > 9) {
                    cin.clear();
                    cin.ignore(1000, '\n');
                    cout << "Ошибка! Нажмите Enter...";
                    cin.get();
                    cin.get();
                    continue;
                }
                
                row = (move - 1) / 3;
                col = (move - 1) % 3;
                
                if (board[row][col] == player1Symbol || board[row][col] == player2Symbol) {
                    cout << "Клетка занята! Нажмите Enter...";
                    cin.get();
                    cin.get();
                    continue;
                }
                
                board[row][col] = player2Symbol;
                
                if (checkWin(player2Symbol)) {
                    winner = 2;
                    break;
                }
                if (checkDraw()) {
                    winner = 3;
                    break;
                }
                currentPlayer = 1;
            }
        }
    }
    
    // Вывод результата
    for (int i = 0; i < 50; i++) cout << "\n";
    drawBoard();
    
    if (winner == 1) {
        cout << "ПОБЕДИТЕЛЬ: " << player1Nick << "!\n";
    } else if (winner == 2) {
        if (gameMode == 1) {
            cout << "ПОБЕДИТЕЛЬ: Компьютер!\n";
        } else {
            cout << "ПОБЕДИТЕЛЬ: " << player2Nick << "!\n";
        }
    } else {
        cout << "НИЧЬЯ!\n";
    }
    
    updateStats(winner);
    
    cout << "\nНажмите Enter для продолжения...";
    cin.ignore();
    cin.get();
}

// Показать статистику
void showStats() {
    for (int i = 0; i < 50; i++) cout << "\n";
    cout << "=== СТАТИСТИКА ===\n\n";
    cout << player1Nick << " (" << player1Symbol << "):\n";
    cout << "  Побед: " << p1Wins << "\n";
    cout << "  Поражений: " << p1Losses << "\n";
    cout << "  Ничьих: " << p1Draws << "\n";
    cout << "  Очки: " << p1Score << "\n\n";
    
    if (gameMode == 1) {
        cout << "Компьютер (" << player2Symbol << "):\n";
    } else {
        cout << player2Nick << " (" << player2Symbol << "):\n";
    }
    cout << "  Побед: " << p2Wins << "\n";
    cout << "  Поражений: " << p2Losses << "\n";
    cout << "  Ничьих: " << p2Draws << "\n";
    cout << "  Очки: " << p2Score << "\n\n";
    
    cout << "Нажмите Enter для возврата...";
    cin.ignore();
    cin.get();
}

