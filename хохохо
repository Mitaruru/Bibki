#include <iostream>
#include <cstdlib>
#include <ctime>
#include <limits>

using namespace std;

// Глобальные переменные
char board[3][3];
int gameMode = 1;          // 1 - с компьютером, 2 - для двоих
char player1Symbol = 'X';
char player2Symbol = 'O';
char player1Color = 1;     // 1 - синий, 2 - зелёный, 3 - красный и т.д. (условно)
char player2Color = 2;
char player1Nick[50] = "Игрок 1";
char player2Nick[50] = "Игрок 2";

// Статистика
int p1Wins = 0, p1Losses = 0, p1Draws = 0;
int p2Wins = 0, p2Losses = 0, p2Draws = 0;
double p1Score = 0, p2Score = 0;

// Функция инициализации доски
void initBoard() {
    for (int i = 0; i < 3; i++) {
        for (int j = 0; j < 3; j++) {
            board[i][j] = '1' + (i * 3 + j);
        }
    }
}

// Функция отображения доски
void drawBoard() {
    cout << "\n     ";
    for (int i = 0; i < 3; i++) {
        for (int j = 0; j < 3; j++) {
            cout << board[i][j];
            if (j < 2) cout << " | ";
        }
        cout << "\n";
        if (i < 2) cout << "    -----------\n     ";
    }
    cout << "\n";
}

// Проверка победы
int checkWin(char symbol) {
    // Проверка строк и столбцов
    for (int i = 0; i < 3; i++) {
        if (board[i][0] == symbol && board[i][1] == symbol && board[i][2] == symbol) return 1;
        if (board[0][i] == symbol && board[1][i] == symbol && board[2][i] == symbol) return 1;
    }
    // Проверка диагоналей
    if (board[0][0] == symbol && board[1][1] == symbol && board[2][2] == symbol) return 1;
    if (board[0][2] == symbol && board[1][1] == symbol && board[2][0] == symbol) return 1;
    return 0;
}

// Проверка ничьи
int checkDraw() {
    for (int i = 0; i < 3; i++) {
        for (int j = 0; j < 3; j++) {
            if (board[i][j] != player1Symbol && board[i][j] != player2Symbol) {
                return 0;
            }
        }
    }
    return 1;
}

// Ход компьютера
void computerMove() {
    for (int i = 0; i < 3; i++) {
        for (int j = 0; j < 3; j++) {
            if (board[i][j] != player1Symbol && board[i][j] != player2Symbol) {
                board[i][j] = player2Symbol;
                return;
            }
        }
    }
}

// Обновление статистики
void updateStats(int winner) {
    // winner: 1 - игрок 1, 2 - игрок 2, 3 - ничья
    if (winner == 1) {
        p1Wins++;
        p1Score += 5.0;
        p2Losses++;
        p2Score -= 6.0;
    } else if (winner == 2) {
        p2Wins++;
        p2Score += 5.0;
        p1Losses++;
        p1Score -= 6.0;
    } else if (winner == 3) {
        p1Draws++;
        p2Draws++;
        p1Score -= 1.2;
        p2Score -= 1.2;
    }
}

