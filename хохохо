            cin.ignore();
            cin.getline(tempNick, 50);
            for (int i = 0; tempNick[i] != '\0'; i++) {
                player2Nick[i] = tempNick[i];
            }
            player2Nick[49] = '\0';
        } 
        else if (choice == 4) {
            cout << "Введите символ для Игрока 1: ";
            cin >> tempSymbol;
            if (tempSymbol != ' ' && tempSymbol != player2Symbol) {
                player1Symbol = tempSymbol;
            } else {
                cout << "Некорректный символ!\n";
                cin.get();
                cin.get();
            }
        } 
        else if (choice == 5) {
            cout << "Введите символ для Игрока 2: ";
            cin >> tempSymbol;
            if (tempSymbol != ' ' && tempSymbol != player1Symbol) {
                player2Symbol = tempSymbol;
            } else {
                cout << "Некорректный символ!\n";
                cin.get();
                cin.get();
            }
        } 
        else if (choice == 6) {
            break;
        }
